    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "meilisearch": "^0.62.0",
    "next": "16.3.8",
    "postcss": "~8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-instantsearch": "^7.51.0",
    "react-instantsearch-router-nextjs": "^7.51.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.4",
