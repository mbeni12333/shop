{
  "name": "edoctor-storefront",
  "version": "1.2.5",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "lhci": "lhci autorun",
    "lhci:perf": "lhci autorun --collect.settings.preset=perf",
    "lhci:desktop": "lhci autorun --collect.settings.preset=desktop",
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playwright": "playwright test",
    "playwright:ui": "playwright test --ui",
    "playwright:debug": "playwright test --debug",
    "playwright:codegen": "playwright codegen",
    "doctor": "echo n | react-doctor --verbose",
    "doctor:score": "echo n | react-doctor --score",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:catalog": "node scripts/test-catalog.mjs",
    "catalog:audit": "node scripts/build-woo-import.mjs",
    "catalog:import": "node scripts/build-woo-import.mjs --write"
  },
  "keywords": [
    "next.js",
    "portfolio",
    "next",
    "javascript",
    "framer"
  ],
  "author": "w3bdesign",
  "license": "AGPL-3.0",
