{
  "name": "edoctor-storefront",
  "version": "1.2.5",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "lhci": "lhci autorun",
    "lhci:research": "lhci autorun --config=lighthouserc.research.cjs",
    "lhci:perf": "lhci autorun --collect.settings.preset=perf",
    "lhci:desktop": "lhci autorun --collect.settings.preset=desktop",
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playwright": "playwright test",
    "playwright:ui": "playwright test --ui",
    "playwright:debug": "playwright test --debug",
    "playwright:codegen": "playwright codegen",
    "doctor": "echo n | react-doctor --verbose",
    "doctor:score": "echo n | react-doctor --score",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "search:sync": "node scripts/sync-search.mjs",
    "search:watch": "node scripts/sync-search.mjs --watch",
    "test:catalog": "node scripts/test-catalog.mjs",
    "catalog:audit": "node scripts/audit-catalog-research.mjs",
    "seed:generate": "node scripts/generate-research-seed.mjs",
    "seed:check": "node scripts/generate-research-seed.mjs --check",
    "test:research": "node scripts/test-research.mjs"
  },
  "keywords": [
    "next.js",
    "portfolio",
    "next",
    "javascript",
    "framer"
  ],
  "author": "w3bdesign",
  "license": "AGPL-3.0",
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@meilisearch/instant-meilisearch": "^0.31.4",
    "@types/react": "^19.2.18",
    "autoprefixer": "^10.5.4",
    "graphql": "^17.0.2",
    "meilisearch": "^0.62.0",
    "next": "16.3.8",
    "postcss": "~8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-instantsearch": "^7.44.1",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "@lhci/cli": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@prettier/plugin-php": "^0.25.0",
    "@types/node": "25.9.8",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.13",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
