# Public settings are compiled into the image; rebuild when they change.
# Never put private credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_MEILI_URL=
NEXT_PUBLIC_MEILI_SEARCH_KEY=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PHONE=
IMAGE_HOSTS=

# Server-only WordPress / WooGraphQL endpoints.
# Local research preview; disabled for commercial deployment. A configured
# GraphQL endpoint always takes precedence. Rebuild when this value changes.
EDOCTOR_RESEARCH_PREVIEW=0
GRAPHQL_URL=
WORDPRESS_URL=
SITE_URL=
WOOCOMMERCE_ACCOUNT_URL=
# Independent random secrets, at least 32 characters, shared with the WP bridge.
CHECKOUT_SECRET=
REVALIDATE_SECRET=

# Compose and search worker.
STOREFRONT_IMAGE=
MEILI_MASTER_KEY=
MEILI_INDEX_KEY=
MEILI_URL=http://search:7700
MEILI_ADMIN_KEY=
SYNC_STATE_DIR=.sync-state
